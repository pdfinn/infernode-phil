#!/dis/sh.dis
# phil/scope [-x] logicfile [document] - whether the argument read in
# logicfile turns on the scope of a necessity or an ought.  "If p, then
# necessarily q" may put the necessity on q alone, p → □q, or on the
# whole, □(p → q): the necessity of the consequent, q itself necessary
# once p holds, or only of the consequence, q following from p of
# necessity.  An argument may need the first where the text gives only
# the second (if God foresees it, it must happen).  The same for ought: "if you promise, you ought to keep it".
# phil/prove -s turns over each such premise or assumption, one at a
# time, and the argument is proved again: where its verdict changes,
# argue/scope says so, at the statement, with both readings.  Not
# marked: a reading on the whole that holds and fails on the consequent
# alone, since it needs only the necessity of the consequence.  A
# premise read as conceptual (kind conceptual) is taken as necessary.
# Which the
# sentence means, and which is true, is not the prover's to say: the
# finding marks where the argument turns.  No model is asked.
load std

fn usage {
	echo 'usage: phil/scope [-x] logicfile [document]' >[1=2]
	raise fail:usage
}

x=()
args=$*
while {~ ${hd $args} -*} {
	if {~ ${hd $args} -x} {
		x=-x
	} {
		usage
	}
	args=${tl $args}
}
if {~ $#args 0} {usage}
logic=${hd $args}
doc=${tl $args}

# a premise read as conceptual, true by what its words mean, is true of
# necessity: in a modal reading it is written so, and where it is the
# antecedent the two scopes come to the same.  The file proved is a
# copy; the reading itself is not changed
orig=$logic
logic=$orig^.nec
awk -F '	' -v 'OFS=	' '
	$1 == "logic" && $2 ~ /^s5/ { modal = 1 }
	modal && $1 ~ /^[PA][0-9]+$/ && $0 ~ /	kind conceptual/ && $3 !~ /^(□|\[\])/ { $3 = "□(" $3 ")" }
	{ print }' $orig > $logic

valid='/argue\/valid -?[0-9]+$/ { v = $NF } END { print v }'
# a conclusion that only restates a premise follows from it: for the
# scope, the argument holds, though prove calls it circular
v0=`{phil/prove $logic $doc >[2=1] | awk 'BEGIN { c = 0 } /argue\/circular: C[0-9]* \(/ { c = 1 } /argue\/valid -?[0-9]+$/ { v = $NF } END { if(c && v == 0) print "1 restated"; else print v }'}
restated=()
if {~ ${tl $v0} restated} {
	restated=1
}
v0=${hd $v0}
rm -f $logic^.scopefound

# one reading turned over, in $1: what the verdict does
fn try {
	phil/prove $1 $doc > $logic^.scopeout >[2=1]
	v1=`{awk $valid $logic^.scopeout}
	# (an unset variable is 0 to this awk, not "")
	fails=`{awk 'BEGIN { f = "" } /argue\/invalid: [^ ]+ \(S[0-9]+\)/ { if(!got){ i = index($0, "argue/invalid: "); r = substr($0, i+15); j = index(r, ")"); f = substr(r, 1, j); got = 1 } } END { print f }' $logic^.scopeout}
	sed 1q $1 | awk -F '	' -v 'v0='^$"v0 -v 'v1='^$"v1 -v 'fails='^$"fails -v 'logic='^$orig -v 'restated='^$"restated '{
		at = $2
		if($3 != "-")
			at = at " (" $3 ")"
		holds = "the argument holds"
		if(restated == "1")
			holds = "the conclusion follows, restating it"
		what = fails
		if(what == "")
			what = "the conclusion"
		needs = "it needs the necessity of the consequent, not only of the consequence"
		if($5 == "obligation")
			needs = "it needs the ought on the consequent alone (narrow scope), not only on the conditional (wide)"
		else if($5 != "necessity")
			needs = "it needs the necessity or ought on the consequent in one of them"
		if($6 == "-"){
			# every one turned over together
			if(v0 == 1 && v1 == 0)
				print logic ": argue/scope: " at ": read with the " $5 " on the consequent in each, " holds "; read with it on the whole conditional in all of them together, " what " does not follow: " needs ", and which the sentences mean decides the argument"
			next
		}
		if($4 == "consequent"){
			as = "with the " $5 " on its consequent alone, " $6
			other = "with it on the whole conditional, " $7
		}else{
			as = "with the " $5 " on the whole conditional, " $6
			other = "with it on the consequent alone, " $7
		}
		# the necessity of the consequent needed: holds read so and not
		# on the whole, or the other way about; a reading on the whole
		# that holds needs only the necessity of the consequence
		if(v0 == 1 && v1 == 0 && $4 == "consequent")
			print logic ": argue/scope: " at ": read " as ", " holds "; read " other ", " what " does not follow: " needs ", and which the sentence means decides the argument"
		else if(v0 == 0 && v1 == 1 && $4 == "whole")
			print logic ": argue/scope: " at ": read " as ", the argument fails; read " other ", it holds: " needs ", and which the sentence means decides the argument"
		else if(v0 == 0 && v1 == 1)
			print logic ": argue/scope: " at ": read " as ", the argument fails; read " other ", it holds: which the sentence means decides the argument"
	}' | tee -a $logic^.scopefound
}

k=1
more=1
while {~ $more 1} {
	phil/prove -s $k $logic > $logic^.scope >[2] /dev/null
	if {! ftest -s $logic^.scope} {
		more=0
	} {
		try $logic^.scope
	}
	k=`{echo $k + 1 | calc}
}
# none alone: all together, where two premises each give what the
# other does
if {! ftest -s $logic^.scopefound} {
	phil/prove -S $logic > $logic^.scope >[2] /dev/null
	if {ftest -s $logic^.scope} {
		try $logic^.scope
	}
}
rm -f $logic^.scope $logic^.scopeout $logic^.scopefound $logic
