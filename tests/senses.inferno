#!/dis/sh.dis
# senses.inferno phildir wwbdir port - phil/senses on data/senses/end
# four times, against tests/fakellm.py answering with
# data/senses/replies in turn; run by tests/senses_test.sh.
load std

phil=$1
wwb=${hd ${tl $*}}
port=${hd ${tl ${tl $*}}}
bind -a '#I' /net
ndb/cs
run $phil/philns $phil $wwb
wwbmodel='openai http://127.0.0.1:'^$port^'/v1'
cd $phil/tests
mkdir -p out
for i in 1 2 3 4 5 {
	cp data/senses/end.logic out/senses.logic
	echo '#' ask $i
	phil/senses -m fake-model -d data/senses/end.md out/senses.logic
	if {ftest -f out/senses.logic.sense1} {
		echo '#' kept split
		grep '^atom	|^P2' out/senses.logic.sense1
	}
	sed 1q out/senses.logic.senses
	echo '#' files
	ls out | grep 'senses\.logic\.'
	rm -f out/senses.logic.*
	echo '#' end $i
}
echo halt > /dev/sysctl
