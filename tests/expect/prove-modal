% data/argue/modal/fallacy.logic, for a first-order prover
% logic s5, by the standard translation: each atom holds at a world, w0 the actual one
% p: the bachelor is unmarried
% q: he is unmarried
fof(p1, axiom, (! [W1] : (p(W1) => q(W1)))).
fof(p2, axiom, p(w0)).
fof(c, conjecture, (! [W2] : q(W2))).
