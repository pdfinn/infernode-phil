#!/dis/sh.dis
# prove.inferno phildir wwbdir outdir - for each logic file of data/argue,
# phil/prove's verdict (name.ours) and its TPTP form (name.p) in outdir;
# run by tests/prove_z3_test.sh.
load std

phil=$1
wwb=${hd ${tl $*}}
*=($phil ${tl ${tl $*}})
outdir=${hd ${tl $*}}
run $phil/philns $phil $wwb
cd $phil/tests
for f in data/argue/*.logic data/argue/k/*.logic data/argue/modal/*.logic {
	b=`{basename $f .logic}
	phil/prove -t $f > $outdir/$b.p >[2] /dev/null
	phil/prove $f > $outdir/$b.ours >[2] /dev/null
}
echo halt > /dev/sysctl
