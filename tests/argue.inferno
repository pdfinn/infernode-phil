#!/dis/sh.dis
# argue.inferno phildir wwbdir port - phil/argue calling an OpenAI-compatible
# API directly (no llmsrv), tests/fakellm.py, answering with
# data/argue/reply; run by tests/argue_test.sh.
load std

phil=$1
wwb=${hd ${tl $*}}
*=($phil ${tl ${tl $*}})
port=${hd ${tl $*}}
bind -a '#I' /net
ndb/cs
run $phil/philns $phil $wwb
wwbmodel='openai http://127.0.0.1:'^$port^'/v1'
cd $phil/tests
mkdir -p out
# -d names another document to argue
args=${tl ${tl $*}}
doc=data/argue/sample.md
if {~ ${hd $args} -d} {
	doc=${hd ${tl $args}}
	args=${tl ${tl $args}}
}
phil/argue -m fake-model $args -o out/argue.logic $doc
echo '#' the logic file
cat out/argue.logic
echo halt > /dev/sysctl
