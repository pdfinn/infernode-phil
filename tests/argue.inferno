#!/dis/sh.dis
# argue.inferno wwbdir port - wwb/argue calling an OpenAI-compatible
# API directly (no llmsrv), tests/fakellm.py, answering with
# data/argue/reply; run by tests/argue_test.sh.
load std

wwb=$1
port=${hd ${tl $*}}
bind -a '#I' /net
ndb/cs
run $wwb/wwbns $wwb
wwbmodel='openai http://127.0.0.1:'^$port^'/v1'
cd $wwb/tests
mkdir -p out
# -d names another document to argue
args=${tl ${tl $*}}
doc=data/argue/sample.md
if {~ ${hd $args} -d} {
	doc=${hd ${tl $args}}
	args=${tl ${tl $args}}
}
wwb/argue -m fake-model $args -o out/argue.logic $doc
echo '#' the logic file
cat out/argue.logic
echo halt > /dev/sysctl
